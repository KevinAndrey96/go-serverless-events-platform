APP_NAME="Portal de eventos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=events_portal
DB_USERNAME=events_portal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mail with the QR ticket. Mailpit locally; SES or any SMTP relay in production.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="eventos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Events API: the Go dev server locally, the ApiUrl output of the SAM stack in AWS.
EVENTS_API_URL=http://localhost:8080
EVENTS_API_TIMEOUT=10
# true in AWS: admin routes are signed with SigV4 using the default credential chain.
EVENTS_API_SIGN=false
EVENTS_API_REGION=us-east-1
EVENTS_TIMEZONE=America/Bogota

# First administrator, created by `php artisan db:seed` (password of 12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
